# 本文件是配置示例，程序不会自动读取 .env。
# 将变量导出到当前终端，或直接启动后在设置界面输入 API 凭据。
# API 凭据在 https://my.telegram.org/apps 获取；不要提交真实凭据。
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# 可选：默认 $XDG_DATA_HOME/telegram-tui/account.session
# 未设置 XDG_DATA_HOME 时，默认 ~/.local/share/telegram-tui/account.session
# TELEGRAM_SESSION=/your/private/path/account.session

# 可选，用户名和密码中的特殊字符必须进行 URL 编码。
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# TELEGRAM_PROXY=http://username:password@127.0.0.1:8080
